<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>sync_records_daily</name>
  <description>Daily sync of records from source DB to target DB</description>
  <extended_description/>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2024/01/01 00:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2024/01/01 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>run.mode</name>
      <default_value>incremental</default_value>
      <description>full or incremental</description>
    </parameter>
  </parameters>
  <connection>
    <name>source_mssql</name>
    <server>192.0.2.5</server>
    <type>MSSQL</type>
    <access>Native</access>
    <database>source_db</database>
    <port>1433</port>
    <username>${db.user}</username>
    <password>Encrypted xxx</password>
  </connection>
  <connection>
    <name>target_pg</name>
    <server>192.0.2.7</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>target_db</database>
    <port>5432</port>
    <username>${db.user}</username>
    <password>Encrypted xxx</password>
  </connection>
  <entries>
    <entry>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>50</xloc>
      <yloc>50</yloc>
    </entry>
    <entry>
      <name>truncate_target</name>
      <description/>
      <type>SQL</type>
      <connection>target_pg</connection>
      <sql>TRUNCATE TABLE target.records;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>200</xloc>
      <yloc>50</yloc>
    </entry>
    <entry>
      <name>sync_records</name>
      <description/>
      <type>TRANS</type>
      <filename>${Internal.Job.Filename.Directory}/sync_records.ktr</filename>
      <transname/>
      <directory>/</directory>
      <arg_from_previous>N</arg_from_previous>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>Pentaho local</run_configuration>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>350</xloc>
      <yloc>50</yloc>
    </entry>
    <entry>
      <name>SUCCESS</name>
      <description/>
      <type>SPECIAL</type>
      <start>N</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>500</xloc>
      <yloc>50</yloc>
    </entry>
  </entries>
  <hops>
    <hop>
      <from>START</from>
      <to>truncate_target</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>truncate_target</from>
      <to>sync_records</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>sync_records</from>
      <to>SUCCESS</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
</job>
