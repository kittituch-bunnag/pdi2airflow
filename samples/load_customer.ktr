<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>load_customer</name>
    <description>Read customer master from MSSQL and write to PG staging</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters/>
    <log/>
    <maxdate/>
    <created_user>-</created_user>
    <created_date>2024/01/01 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2024/01/01 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <connection>
    <name>ofm_erp_mssql</name>
    <server>192.0.2.5</server>
    <type>MSSQL</type>
    <access>Native</access>
    <database>source_erp</database>
    <port>1433</port>
    <username>${db.user}</username>
    <password>Encrypted xxx</password>
  </connection>
  <connection>
    <name>target_dwh_pg</name>
    <server>192.0.2.7</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>target_dwh</database>
    <port>5432</port>
    <username>${db.user}</username>
    <password>Encrypted xxx</password>
  </connection>
  <order>
    <hop>
      <from>read_customer</from>
      <to>select_columns</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>select_columns</from>
      <to>write_staging</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>read_customer</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>ofm_erp_mssql</connection>
    <sql>SELECT customer_id, customer_name, created_at FROM dbo.customer_master WHERE created_at &gt;= '${run_date}'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>select_columns</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <fields>
      <field>
        <name>customer_id</name>
        <rename>cust_id</rename>
        <type>Integer</type>
      </field>
      <field>
        <name>customer_name</name>
        <rename>cust_name</rename>
        <type>String</type>
      </field>
      <field>
        <name>created_at</name>
        <rename>created_dt</rename>
        <type>Date</type>
      </field>
    </fields>
    <select_unspecified>N</select_unspecified>
    <GUI>
      <xloc>250</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>write_staging</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>target_dwh_pg</connection>
    <schema>staging</schema>
    <table>customer_master</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <GUI>
      <xloc>400</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
</transformation>
